# Copy this file to ".env" and fill in your values.

# ---- basics ----
PORT=3000
# Your public website address (no trailing slash). REQUIRED in production:
# used for links in emails, password resets and card-payment return URLs.
BASE_URL=https://yourstore.ps
# Set to production on the live server (secure cookies, test-mode payments disabled)
NODE_ENV=development
# Default language for new visitors: ar or en
DEFAULT_LANG=ar
# On the very first start the demo catalog (products, banners, pages…) is loaded once.
# Set to off to start with an empty shop instead.
DEMO_DATA=on

# ---- first admin account (created automatically on first start) ----
ADMIN_EMAIL=tarek@admin.com
ADMIN_PASSWORD=admin

# ---- storage (keep this folder backed up!) ----
DB_PATH=data/store.db
UPLOAD_DIR=data/uploads

# ---- reverse proxy (Nginx / Render / Railway) ----
# auto (default) = trust X-Forwarded-* headers only from local/private proxies; or "always" / "never"
TRUST_PROXY=auto
# how many proxies sit in front of the app (1 for a single Nginx)
PROXY_HOPS=1

# ---- optional: secrets via environment instead of Admin → Settings ----
# Email: smtps://user:password@smtp.yourhost.com:465   (or smtp://...:587 for STARTTLS)
SMTP_URL=
# PayTabs card payments
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_DOMAIN=https://secure-jordan.paytabs.com
# Telegram new-order alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Time zone used for dates in the admin
TZ_DISPLAY=Asia/Hebron
